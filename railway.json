{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx tsc -b packages/shared packages/dto packages/validators && npm run build -w @DeparkHackaton/backend"
  },
  "deploy": {
    "startCommand": "npm run start -w @DeparkHackaton/backend",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
