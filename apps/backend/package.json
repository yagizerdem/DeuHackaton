{
  "name": "@DeparkHackaton/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "cross-env NODE_ENV=production node dist/src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@DeparkHackaton/shared": "^1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15"
  }
}
