{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/apps/backend/src/server.ts",
      "cwd": "${workspaceFolder}/apps/backend",
      "env": { "NODE_ENV": "development" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
